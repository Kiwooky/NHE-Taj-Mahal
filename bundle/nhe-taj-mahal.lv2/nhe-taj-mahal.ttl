@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/Kiwooky/NHE-Taj-Mahal>
    a lv2:Plugin , lv2:ReverbPlugin ;
    doap:name "Taj Mahal" ;
    doap:license <http://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "New Horizon Electronics" ;
        foaf:homepage <https://github.com/Kiwooky/NHE-Taj-Mahal>
    ] ;
    rdfs:comment "Huge chorused hall reverb modelled on the Taj Mahal preset of a classic 1988 rack reverb." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/options#options> ,
                        <http://lv2plug.in/ns/ext/urid#map> ;
    lv2:extensionData <http://lv2plug.in/ns/ext/options#interface> ;
    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Audio In"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L"
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "predelay" ;
        lv2:name "Pre-delay" ;
        lv2:default 81 ;
        lv2:minimum 0 ;
        lv2:maximum 140 ;
        lv2:portProperty lv2:integer ;
        units:unit units:ms
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "decay" ;
        lv2:name "Decay" ;
        lv2:default 72 ;
        lv2:minimum 1 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "diffusion" ;
        lv2:name "Diffusion" ;
        lv2:default 9 ;
        lv2:minimum 0 ;
        lv2:maximum 9 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "chorus_speed" ;
        lv2:name "Chorus Speed" ;
        lv2:default 61 ;
        lv2:minimum 0 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "chorus_depth" ;
        lv2:name "Chorus Depth" ;
        lv2:default 31 ;
        lv2:minimum 0 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "chorus_feedback" ;
        lv2:name "Chorus Feedback" ;
        lv2:default 20 ;
        lv2:minimum 0 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer ;
        units:unit units:pc
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "direct" ;
        lv2:name "Direct" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "reverb_level" ;
        lv2:name "Reverb Level" ;
        lv2:default 99 ;
        lv2:minimum 0 ;
        lv2:maximum 99 ;
        lv2:portProperty lv2:integer
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "vintage" ;
        lv2:name "Vintage" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "tails" ;
        lv2:name "Tails" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "lv2_enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
        lv2:designation lv2:enabled
    ] .