@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/Kiwooky/NHE-Taj-Mahal#preset-taj-mahal-1988-factory>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-Taj-Mahal> ;
    rdfs:label "Taj Mahal (1988 factory)" ;
    rdfs:comment "The original preset: 100% wet hall with stereo chorus." ;
    lv2:port [
        lv2:symbol "predelay" ;
        pset:value 81.0
    ] , [
        lv2:symbol "decay" ;
        pset:value 72.0
    ] , [
        lv2:symbol "diffusion" ;
        pset:value 9.0
    ] , [
        lv2:symbol "chorus_speed" ;
        pset:value 61.0
    ] , [
        lv2:symbol "chorus_depth" ;
        pset:value 31.0
    ] , [
        lv2:symbol "chorus_feedback" ;
        pset:value 20.0
    ] , [
        lv2:symbol "direct" ;
        pset:value 0.0
    ] , [
        lv2:symbol "reverb_level" ;
        pset:value 99.0
    ] , [
        lv2:symbol "vintage" ;
        pset:value 1.0
    ] , [
        lv2:symbol "tails" ;
        pset:value 1.0
    ] .

